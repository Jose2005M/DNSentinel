{
  "manifest_version": 3,
  "name": "DNSentinel · Protección de Chrome",
  "version": "1.2.0",
  "minimum_chrome_version": "120",
  "description": "Sincroniza el bloqueo de páginas con los botones del lanzador DNSentinel.",
  "permissions": [
    "nativeMessaging",
    "declarativeNetRequest",
    "tabs",
    "webNavigation",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DNSentinel: comprobar conexión",
    "default_popup": "status.html"
  },
  "incognito": "not_allowed",
  "key": ""
}
